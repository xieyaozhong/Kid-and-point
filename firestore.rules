rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function isTeacher(familyId) {
      return signedIn() && request.auth.uid in familyDoc(familyId).data.teachers;
    }

    function isParent(familyId) {
      return signedIn() && request.auth.uid in familyDoc(familyId).data.parents;
    }

    function isMember(familyId) {
      return isTeacher(familyId) || isParent(familyId);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /families/{familyId} {
      // Parent joins by typing the exact family code (document id).
      // Listing all families is never allowed.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.teachers == [request.auth.uid]
        && request.resource.data.parents == [];

      // Teachers can maintain family metadata. A new parent may only add
      // themselves to the parents array while preserving existing members.
      allow update: if isTeacher(familyId)
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parents'])
          && request.resource.data.parents.hasAll(resource.data.parents)
          && request.resource.data.parents.hasAny([request.auth.uid])
        );
      allow delete: if isTeacher(familyId);

      match /students/{studentId} {
        allow read: if isMember(familyId);
        allow create, update, delete: if isTeacher(familyId);
      }

      match /tasks/{taskId} {
        allow read: if isMember(familyId);
        allow create, update, delete: if isTeacher(familyId);
      }

      match /submissions/{submissionId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId)
          && request.resource.data.status == 'pending'
          && request.resource.data.submittedBy == request.auth.uid;
        allow update, delete: if isTeacher(familyId);
      }

      match /rewards/{rewardId} {
        allow read: if isMember(familyId);
        allow create, update, delete: if isMember(familyId);
      }

      match /redemptions/{redemptionId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId)
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedBy == request.auth.uid;
        allow update, delete: if isTeacher(familyId);
      }

      match /feedback/{feedbackId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isTeacher(familyId)
          || (signedIn() && resource.data.authorUid == request.auth.uid);
      }

      match /ledger/{entryId} {
        allow read: if isMember(familyId);
        allow create, update, delete: if isTeacher(familyId);
      }
    }
  }
}
